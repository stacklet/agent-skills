{
 "about": "A countdown built from tags rather than mark-for-op: one policy tags old snapshots 0, the next steps the tag to 7, then 14, then 21, and the last deletes what still carries 21 past 183 days. Different filters, one constraint: one bullet, saying the snapshots are deleted and when.",
 "resource_type": "aws.ebs-snapshot",
 "policies": [
  {
   "name": "acme:snapshot-retire-0",
   "version": 1,
   "severity": null,
   "mode": "pull",
   "compliance": [],
   "source": {
    "name": "snapshot-retire-0",
    "resource": "aws.ebs-snapshot",
    "filters": [
     {
      "type": "age",
      "days": 155,
      "op": "gt"
     },
     {
      "type": "value",
      "key": "SnapshotId",
      "op": "not-in",
      "value_from": {
       "url": "s3://example-config/exclusions.csv",
       "format": "csv2dict",
       "expr": "SnapshotId"
      }
     },
     {
      "not": [
       {
        "or": [
         {
          "tag:acme:retire-stage": "0"
         },
         {
          "tag:acme:retire-stage": "7"
         },
         {
          "tag:acme:retire-stage": "14"
         },
         {
          "tag:acme:retire-stage": "21"
         }
        ]
       }
      ]
     },
     {
      "type": "skip-ami-snapshots",
      "value": true
     }
    ],
    "actions": [
     {
      "type": "tag",
      "tags": {
       "acme:retire-stage": "0"
      }
     }
    ]
   }
  },
  {
   "name": "acme:snapshot-retire-1",
   "version": 1,
   "severity": null,
