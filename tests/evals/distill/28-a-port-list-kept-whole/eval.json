    "\\bTCP\\b(?:(?!\\bUDP\\b)[^.;])*\\b123\\b|\\b(TCP (or|and|/) UDP|UDP (or|and|/) TCP|both protocols|either protocol)\\b[^.;]*\\b123\\b"
   ]
  }
