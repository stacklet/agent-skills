{
 "about": "Ingress from anywhere on all ports, on ten TCP ports or on two UDP ports, flagged and removed. Ports 69 and 123 are in both lists: a bullet must not leave them as UDP only, which would tell an agent that TCP 123 open to the world passes (one run of five did).",
 "resource_type": "aws.security-group",
 "policies": [
  {
   "name": "acme:sg-risky-ports-notify",
   "version": 1,
   "severity": "high",
   "mode": "pull",
   "compliance": [],
   "source": {
    "name": "sg-risky-ports-notify",
    "resource": "aws.security-group",
    "filters": [
     {
      "or": [
       {
        "type": "ingress",
        "FromPort": 0,
        "ToPort": 65535,
